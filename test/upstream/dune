(executable
 (name extract_tests)
 (modules extract_tests)
 (libraries re fmt astring))

(test
 (name test)
 (modules test)
 (libraries alcotest tw cascade cascade.diff fmt re)
 (deps utilities.txt variants.txt))

; Pins the [@theme] scanner on the declaration shapes Prettier produces:
; values wrapped over several lines, a [;] or [}] inside a string or a
; comment, and brackets that span lines.

(rule
 (action
  (with-stdout-to
   theme_scanner_actual.txt
   (ignore-stderr
    (run %{exe:extract_tests.exe} %{dep:theme_scanner_input.ts})))))

(rule
 (alias runtest)
 (action
  (diff theme_scanner_expected.txt theme_scanner_actual.txt)))

; Pins the [.toEqual('')] scan on the assertion shapes Prettier produces: an
; argument and a closing [)] on lines of their own, and a wrapped assertion
; whose argument is not the empty string.

(rule
 (action
  (with-stdout-to
   empty_expect_actual.txt
   (ignore-stderr
    (run %{exe:extract_tests.exe} %{dep:empty_expect_input.ts})))))

(rule
 (alias runtest)
 (action
  (diff empty_expect_expected.txt empty_expect_actual.txt)))
