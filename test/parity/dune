; The whole-sheet order gate. It reads the same inputs measure.sh does, and
; reduces the comparison to one number per layer rather than a report to read.
;
; It is a rule rather than a (test) stanza because the tw half has to come from
; the built binary: the entrypoint pipeline that compiles globals.css lives in
; bin/main.ml, and running it is what keeps the gate measuring the sheet the
; documented command produces.

(executables
 (names sheet_order gen_order_fixture frozen_order site_page corpus_check)
 (libraries fmt tw_tools test_helpers cascade.browser))

; package-lock.json pins the tailwindcss the reference comes from, and the CLI
; is not a dune dependency of its own, so a version bump has to re-run the
; measurement rather than leave the cached one standing.

(rule
 (alias runtest)
 (deps
  ref-entry.css
  globals.css
  search.css
  typography.css
  classlist.txt
  ../../package-lock.json)
 (action
  (run %{exe:sheet_order.exe} %{exe:../../bin/main.exe})))

; The same comparison with Tailwind's half frozen, so it runs where the pinned
; CLI does not. It needs tw's binary and the committed sequence, nothing else.

(rule
 (alias runtest)
 (deps
  tailwind_order.txt
  globals.css
  search.css
  typography.css
  classlist.txt)
 (action
  (run %{exe:frozen_order.exe} %{exe:../../bin/main.exe})))

; The parity corpus: every NAME.css under corpus/ is compiled by both tools,
; compared canonically and rendered over NAME.html or a page built from its
; @source inline classes, through the documented command. The glob is the
; registration: a file dropped into the directory is a case on the next run.

(rule
 (alias runtest)
 (deps
  (glob_files corpus/*.css)
  (glob_files corpus/*.html)
  (env_var TW_TAILWIND_TESTS)
  (env_var TW_BROWSER_TESTS)
  ../../package-lock.json)
 (action
  (run %{exe:corpus_check.exe} %{exe:../../bin/main.exe} corpus)))
