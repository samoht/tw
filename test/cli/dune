(cram
 (deps %{bin:tw} prefixes.css prefixes.html))

; These stand a [#!/bin/sh] stub in for the Tailwind CLI, and the backend they
; drive runs it through a POSIX shell ([2>/dev/null], [| head -1], an
; extensionless [node_modules/.bin/tailwindcss]), so neither runs under cmd.exe.

(cram
 (applies_to reference-cli entry-imports scratch tailwind-entrypoint)
 (enabled_if
  (<> %{os_type} Win32)))

; The pinned tailwindcss CLI compiles the reference here. TW_TAILWIND_TESTS=1
; says the CLI is meant to be present, so a missing npx fails rather than
; retiring the case from the suite.

(cram
 (applies_to diff-reference)
 (deps ../../package-lock.json)
 (enabled_if
  (or
   %{bin-available:npx}
   (= %{env:TW_TAILWIND_TESTS=0} 1))))
